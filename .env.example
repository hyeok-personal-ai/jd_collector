# IMPORTANT: .env is a reference only; the application does not auto-load it.
# Set these variables in your shell / process manager before running.
DATABASE_URL=sqlite:///./recruit.db
# DATABASE_URL=postgresql+psycopg://recruit:password@localhost:5432/recruit
CRAWLER_USER_AGENT=RecruitRadarBot/0.4 (+mailto:YOUR_REAL_CONTACT@yourdomain.example)
REQUEST_DELAY_SECONDS=2.0
MAX_LIST_PAGES=2
# Optional standard Playwright renderer, ONLY after site policy review
RENDER_JS=0

# Full listing audit periodically re-processes unchanged list HTML so silent
# edits on individual detail pages do not go undiscovered indefinitely.
LISTING_FULL_SCAN_HOURS=72
# Detail pages rechecked at least every 24h whenever encountered in listings.
DETAIL_RECHECK_HOURS=24
# 1 temporarily overrides cached listing ETags and early-stop pagination.
CRAWL_BACKFILL=0

# Licensed Saramin API: https://oapi.saramin.co.kr/guide/info
SARAMIN_ACCESS_KEY=
# Local daily safety buffer: one API call may retry on HTTP failures. Max 500.
SARAMIN_DAILY_REQUEST_CAP=450

# Licensed Wanted OpenAPI: https://openapi.wanted.jobs/
# Paste an ACTUAL partner-provided endpoint, not a website endpoint guessed from DevTools.
# The public application form grants client-ID and client-secret; do not treat
# those automatically as a Bearer token. Follow your issued API specification.
WANTED_APPROVED_LIST_URL=
WANTED_AUTH_HEADER=
WANTED_AUTH_VALUE=

# For HTML modes ONLY AFTER confirming site terms + obtaining required permission:
# ALLOW_HTML_JOBKOREA=1
# ALLOW_HTML_INCRUIT=1
# ALLOW_HTML_INTHISWORK=1
# ALLOW_HTML_ZIGHANG=1

# Optional local LLM
NORMALIZATION_LLM_MODEL=
OLLAMA_URL=http://localhost:11434

# v1.5 공식 공개 피드 — 신청이나 API 키 필요 없음
PUBLIC_GREENHOUSE_BOARDS=get-delight,seoulrobotics,marqvision,moloco
PUBLIC_LEVER_SITES=zoyi,palantir,clovirtualfashion,matchgroup
PUBLIC_ASHBY_BOARDS=furiosa-ai
# ID를 확인한 회사만 추가; 빈 값이면 건너뜀
PUBLIC_SMARTRECRUITERS_COMPANIES=
# Lever에서 유럽 지역 사이트를 수집할 때만 eu
PUBLIC_LEVER_REGION=

# v1.6 optional settings (no credential required for public ATS GET)
# PUBLIC_BOARD_CATALOG=/absolute/path/to/boards.json
# PUBLIC_GREENHOUSE_BOARDS=moloco
# PUBLIC_LEVER_SITES=zoyi,palantir
# PUBLIC_ASHBY_BOARDS=furiosa-ai,friendliai
# PUBLIC_SMARTRECRUITERS_COMPANIES=SAPITBusinessSysteme
PUBLIC_SR_COUNTRY=kr
# COMPANY_JOB_PAGES_FILE=/absolute/path/to/permitted-pages.json
# ALLOW_HTML_COMPANY_JSONLD=1   # ONLY after verifying actual access and reuse permission
# Force unconditional published-feed retrieval at least this often
PUBLIC_FEED_FULL_AUDIT_HOURS=72
